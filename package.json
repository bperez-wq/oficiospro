{
  "name": "oficiospro-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/clean-static-export.js",
    "build": "next build",
    "pages:build": "next build",
    "predeploy": "npm run validate && npm run build",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --assets ./out",
    "release:gate": "node scripts/platform-release-gate.mjs",
    "release:gate:strict": "node scripts/platform-release-gate.mjs --require-clean",
    "start": "next start",
    "validate": "node scripts/validate-project.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\" \"worker/**/*.test.ts\"",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:status:remote": "wrangler d1 migrations list DB --remote",
    "kaizen:audit": "node scripts/kaizen-worktree-audit.mjs",
    "ops:specialist-intake": "node scripts/generate-specialist-intake-report.mjs",
    "pilot:readiness": "node scripts/pilot-readiness-check.mjs",
    "pilot:readiness:strict": "node scripts/pilot-readiness-check.mjs --require-admin",
    "test:leads": "node scripts/test-lead-endpoints.mjs",
    "test:payout-calculator": "node scripts/test-specialist-payout-calculator.mjs",
    "test:platform-commission": "node scripts/test-platform-commission-model.mjs",
    "test:tax-document-controls": "node scripts/test-tax-document-controls.mjs",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:live-audit": "node scripts/seo-live-audit.mjs",
    "seo:local:sync": "node --import tsx scripts/sync-seo-local-data.mjs",
    "seo:local:verify": "node scripts/verify-seo-local-landings.mjs",
    "soro:audit": "node scripts/soro-content-audit.mjs",
    "soro:import": "node scripts/import-soro-draft.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.0",
    "@emnapi/runtime": "1.11.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.7",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "wrangler": "4.99.0"
  }
}
