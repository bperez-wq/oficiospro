# OficiosPro MCP server configuration

# Base URL of the deployed OficiosPro Worker (no trailing slash).
# Default: https://oficiospro.cl
OFICIOSPRO_BASE_URL=https://oficiospro.cl

# Admin token used to authenticate the read-only admin API calls.
# Required. Keep this secret; do NOT commit your real token.
OFICIOSPRO_ADMIN_TOKEN=replace-with-your-admin-token
